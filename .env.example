# ── MongoDB Database ──
# Get your connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appname>"

# ── Cloudinary (Image & Video Uploads) ──
# Get from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Chat Relay Server ──
# URL of your chat relay WebSocket server (update to production URL when deploying)
VITE_CHAT_RELAY_URL="http://localhost:3001"

# ── Zoho Mail SMTP Delivery (Server-Only Credentials) ──
SMTP_HOST="smtp.zoho.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@zoho.com"
SMTP_PASS="your_app_password"
NOTIFICATION_RECIPIENT_EMAIL="your-destination@domain.com"

