# ── MongoDB Database ──
# Get your connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appname>"

# ── Cloudinary (Image & Video Uploads) ──
# Get from Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Chat Relay Server ──
# URL of your chat relay WebSocket server (update to production URL when deploying)
VITE_CHAT_RELAY_URL="http://localhost:3001"
